# Required — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — defaults shown
ANTHROPIC_MODEL=claude-sonnet-5
MAX_OUTPUT_TOKENS=2000

MAX_SUBPAGES=5
PAGE_TIMEOUT_MS=15000
NAV_RETRIES=2
CONCURRENT_PAGES=3

MAX_CHARS_PER_PAGE=6000
MAX_CHARS_TOTAL=20000

# Optional bonus feature — LinkedIn fallback search for founders not
# found on-site. Get a free key at https://tavily.com. Leave blank to
# skip this step entirely.
TAVILY_API_KEY=

# Optional — only used for the cost estimate printed at the end of a run.
# Check https://www.anthropic.com/pricing for current rates.
PRICE_PER_M_INPUT=3.00
PRICE_PER_M_OUTPUT=15.00
