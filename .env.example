# Required — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — defaults shown
ANTHROPIC_MODEL=claude-sonnet-5
MAX_OUTPUT_TOKENS=2000
LLM_MAX_RETRIES=5

# --- Agent loop ---
MAX_AGENT_STEPS=8          # tool-call turns per domain before forcing a finalization
DOMAIN_CONCURRENCY=3       # how many domains are researched in parallel

# --- Crawling ---
PAGE_TIMEOUT_MS=15000
NAV_RETRIES=2
MAX_CHARS_PER_PAGE=6000

# --- Disk cache (cost/latency optimization only, safe to disable/delete) ---
CACHE_ENABLED=true
CACHE_DIR=.cache/pages
CACHE_TTL_SECONDS=86400

# Optional bonus tool — lets the agent search the open web to resolve a
# LinkedIn URL for a founder found on-site but not linked there. Get a
# free key at https://tavily.com. Leave blank to skip this tool entirely
# (the agent is told it's unavailable and proceeds without it).
TAVILY_API_KEY=

# Optional — only used for the cost estimate printed at the end of a run.
# Check https://www.anthropic.com/pricing for current rates.
PRICE_PER_M_INPUT=3.00
PRICE_PER_M_OUTPUT=15.00
